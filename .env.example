# Copy this file to .env for local development.
# Never commit the populated .env file.

# Enables brain-guided candidate discovery and bounded explanation prose.
OPENAI_API_KEY=

# Cost-conscious default for query-time discovery. Override when evaluating models.
OPENAI_MODEL=gpt-5.6-luna

# Required for MusicBrainz verification. Use an email address or project URL.
MUSICBRAINZ_CONTACT=

# Optional query-time signal. Last.fm data is never stored in the corpus.
LASTFM_API_KEY=
