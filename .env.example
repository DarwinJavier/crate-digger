# Copy this file to .env for local development.
# Never commit the populated .env file.

# Keep false for local development. Set true only on the public deployment to
# hide evaluation tools, API documentation, health details, and internal reports.
PUBLIC_MODE=false

# Directory for durable public feedback. On Render, point this to the persistent
# disk mount. The local default is build/.
PUBLIC_DATA_DIR=build

# Protects the owner-only CSV feedback export. Use a long random value in hosting.
FEEDBACK_ADMIN_TOKEN=

# Enables brain-guided candidate discovery and bounded explanation prose.
OPENAI_API_KEY=

# Cost-conscious default for query-time discovery. Override when evaluating models.
OPENAI_MODEL=gpt-5.6-luna

# Required for MusicBrainz verification. Use an email address or project URL.
MUSICBRAINZ_CONTACT=

# Optional query-time signal. Last.fm data is never stored in the corpus.
LASTFM_API_KEY=

# Optional Spotify account connection, private playlists, and playback controls.
# Create your own Web API app in the Spotify Developer Dashboard. No secret needed:
# the backend uses Authorization Code with PKCE and keeps tokens in process memory.
SPOTIFY_CLIENT_ID=
# Must exactly match a registered redirect URI. Use 127.0.0.1, not localhost.
# For hosting, use the actual HTTPS origin plus /spotify/callback.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
